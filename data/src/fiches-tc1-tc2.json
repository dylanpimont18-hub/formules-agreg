    "bloc": "TC1",
    "notion": "TC1.2 Contraintes technico-économiques",
    "nom": "Temps de retour actualisé",
    "tex": "\\sum_{n=1}^{[[T_{ra}|N|\\mathrm{TRI}]]} \\frac{[[F_n|C_0|F_n \\cdot n]]}{(1+i)^n} = [[C_0|0|\\mathrm{VAN}]]",
