    "tex": "[[T_r|\\mathrm{ROI}|\\mathrm{VAN}]] = \\frac{[[\\Delta I_0|\\Delta G|I_0 \\cdot i]]}{[[\\Delta G|\\Delta I_0|\\Delta G \\cdot N]]}",
