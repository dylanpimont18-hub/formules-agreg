  {
    "id": "tc1-van",
    "bloc": "TC1",
    "notion": "TC1.2 Contraintes technico-économiques",
    "nom": "Valeur actuelle nette (VAN)",
    "tex": "[[\\mathrm{VAN}]] = [[-C_0|C_0|-C_0 \\cdot (1+i)]] + \\sum_{n=1}^{N} \\frac{[[F_n|C_0|n F_n]]}{[[(1+i)^n|(1+i)^{-n}|(1-i)^n|(1+i) n]]}",
    "legende": "$C_0$ investissement initial (€) ; $F_n$ flux net de l'année $n$ (€) ; $i$ taux d'actualisation ; $N$ horizon (ans). Projet rentable si $\\mathrm{VAN} > 0$",
    "grandeurs": [
      { "s": "\\mathrm{VAN}", "nom": "valeur actuelle nette", "u": "\\text{€}" },
      { "s": "C_0", "nom": "investissement initial", "u": "\\text{€}" },
      { "s": "F_n", "nom": "flux net de l'année n", "u": "\\text{€}" },
      { "s": "i", "nom": "taux d'actualisation", "u": "" },
      { "s": "N", "nom": "horizon d'étude", "u": "\\text{an}" }
    ],
    "source": "Fiche TC1.2"
  },
